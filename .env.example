# ReportArchive API
REPORT_API_BASE_URL=http://localhost:3000/api
REPORT_API_WORKSPACE_SLUG=dx

# Service account (created via admin -> auth/register -> workspaces/{slug}/members)
REPORT_API_EMAIL=bot@reportskill.app
REPORT_API_PASSWORD=change-me

# --- Corporate-network transport (v0.16.0) ---
# By default the client IGNORES HTTP(S)_PROXY env vars so a corporate proxy
# never hijacks intranet/localhost API traffic. Set to true to honor them
# (httpx then also respects NO_PROXY).
REPORT_API_TRUST_ENV=false
# Path to a corporate root-CA bundle (PEM) for an https server behind TLS
# inspection or a self-signed/internal cert. Blank = built-in certifi roots.
REPORT_API_CA_BUNDLE=
# Last-resort escape hatch — set false to skip TLS verification entirely.
# Prefer REPORT_API_CA_BUNDLE; only disable verification on a trusted LAN.
REPORT_API_VERIFY_TLS=true

# DEV-MAINTAINER ONLY — leave blank for receiver installs.
# Path to a local ReportArchive backend checkout, used solely by
# `report-skill catalog sync` to extract content_schema_for(...) via a
# read-only subprocess in that backend's venv. Receivers use the bundled
# snapshot and never need this.
REPORT_BACKEND_PATH=

# AI tier override. Auto-detected on first use if unset.
# S=premium (Opus/GPT-5), M=mid (Sonnet/4o), W=weak (local 8B)
SKILL_AI_TIER=

# --- Internal LLM provider (used by `report from-prompt`, `report revise`, etc.) ---
# As of v0.16.0 every key in THIS file is exported into the process env at
# startup, so the os.environ-only knobs below (SKILL_LLM_*, OLLAMA_*,
# REPORT_FRONTEND_URL, and the API keys) all take effect from .env.
#
# Optional provider API keys (only the active provider's key is needed):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Pick the provider explicitly. Auto-detected from API keys when unset.
# Values: bridge | anthropic | openai | ollama
SKILL_LLM_PROVIDER=

# Override the model on whichever provider is active.
# Examples: claude-haiku-4-5-20251001 / gpt-4o-mini / llama3.1:8b
SKILL_LLM_MODEL=

# Bridge mode (SKILL_LLM_PROVIDER=bridge): seconds to wait for a Claude Code chat
# response file before timing out. Default 600.
SKILL_BRIDGE_TIMEOUT=600

# --- Ollama (local 8B fallback) ---
# Base URL for a local Ollama server. Default http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to pull/use. Default llama3.1:8b. Overridden by SKILL_LLM_MODEL when set.
OLLAMA_MODEL=llama3.1:8b

# Frontend origin override for view_url links — set when the SPA runs on a
# different origin than the API (e.g. vite dev :3001 vs uvicorn :3000).
# Leave blank for combined deployment (frontend served by the backend).
REPORT_FRONTEND_URL=
